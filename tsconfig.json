{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "runtime/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
