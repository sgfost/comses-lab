{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../shared/**/*.ts"]
}
